---
const isDe = Astro.url.pathname === '/de/' || Astro.url.pathname.startsWith('/de/');
---
<section class="cta-wrap section"><div class="shell"><div class="cta-panel"><div class="cta-radial"></div><span class="eyebrow">{isDe ? 'IHR NÄCHSTER VORTEIL IM BETRIEB' : 'YOUR NEXT OPERATIONAL ADVANTAGE'}</span><h2>{isDe ? 'Kubernetes intelligent' : 'Make Kubernetes'}<br/><em>{isDe ? 'betreiben.' : 'intelligently operable.'}</em></h2><p>{isDe ? 'Entdecken Sie die Möglichkeiten kontrollierter, KI-gestützter Operations für Ihr Plattformteam.' : 'Explore what governed, AI-assisted operations could mean for your platform team.'}</p><div class="button-group center"><a class="btn btn-primary" href={isDe ? '/de/console/' : '/console/'}>{isDe ? 'Console-Vorschau entdecken' : 'Explore Console Preview'} <span>↗</span></a><a class="btn btn-secondary" href={isDe ? '/de/enterprise/' : '/enterprise/'}>{isDe ? 'Enterprise-Anfrage' : 'Talk Enterprise'} <span>↗</span></a></div></div></div></section>
