---
const letters = [{"char":"K","color":"#27A8F2"},{"char":"U","color":"#48BDF7"},{"char":"B","color":"#76D1FF"},{"char":"E","color":"#B4E5FF"},{"char":"R","color":"#2DBF80"},{"char":"N","color":"#27A8F2"},{"char":"A","color":"#2E75CF"},{"char":"U","color":"#F47B16"},{"char":"T","color":"#FFA52D"},{"char":"I","color":"#FFD45A"},{"char":"C","color":"#27A8F2"}];
---
<span class="kubernautic-wordmark" role="img" aria-label="KUBERNAUTIC">
  {letters.map(({ char, color }) => <span aria-hidden="true" style={`color:${color}`}>{char}</span>)}<span class="wordmark-dot" aria-hidden="true">.</span>
</span>
<style>
  .kubernautic-wordmark { display:inline-flex; align-items:baseline; white-space:nowrap; font-family:"Space Grotesk",sans-serif; font-weight:800; font-size:.88em; line-height:1; letter-spacing:normal; gap:.11em; }
  .kubernautic-wordmark > span { display:inline-block; }
  .kubernautic-wordmark .wordmark-dot { color:#fff; margin-left:.055em; }
</style>
