---
import Base from '../layouts/Base.astro';
import IncidentExplorer from '../components/IncidentExplorer.astro';
---
<Base title="Incident Experience | Kubernautic" description="Explore a guided, fully simulated Kubernetes CrashLoopBackOff investigation, from signals to governed recommendations.">
  <section class="shell page-hero incident-page-hero">
    <span class="eyebrow">PRODUCT EXPERIENCE / INTERACTIVE WALKTHROUGH</span>
    <h1>From incident noise<br/><span class="gradient-text">to operational clarity.</span></h1>
    <p>Step inside a simulated Kubernetes incident. See how evidence, context and AI-assisted recommendations could help engineers make informed decisions — without touching a real cluster.</p>
    <div class="button-group">
      <a class="btn btn-primary" href="#incident-experience">Start guided walkthrough ↗</a>
      <a class="btn btn-secondary" href="/architecture/">Explore the Architecture ↗</a>
    </div>
  </section>
  <section class="shell incident-section" id="incident-experience">
    <IncidentExplorer />
  </section>
  <section class="shell section single-section incident-next">
    <div class="note-panel">
      <div>
        <span class="eyebrow">THE REAL CONSOLE / COMING LATER</span>
        <h2>A read-only preview is next.</h2>
        <p>This walkthrough is a static, synthetic scenario. The separately planned registered Console Preview will use scoped read-only access to a shared demo cluster. There is no signup, cluster connection or remediation execution on this page.</p>
      </div>
      <a class="btn btn-primary" href="/contact/">Ask about Early Access ↗</a>
    </div>
    <div class="info-line"><strong>Demo</strong>Static scenario, no real Kubernetes API calls</div>
    <div class="info-line"><strong>Safety</strong>No mutations, no credentials, no execution</div>
    <div class="info-line"><strong>Production</strong>Dedicated console deployment assessed per customer</div>
  </section>
</Base>
