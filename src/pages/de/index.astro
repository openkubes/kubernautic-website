---
import Base from '../../layouts/Base.astro';
import Network from '../../components/Network.astro';
import CTA from '../../components/CTA.astro';
---
<Base title="Kubernautic | Agentic AI für Kubernetes Operations" description="Entdecken Sie KI-gestützte Kubernetes Operations mit nachvollziehbaren Analysen, Empfehlungen und menschlicher Kontrolle.">
  <section class="hero shell">
    <div class="hero-copy"><div class="eyebrow"><span class="eyebrow-line"></span> KUBERNAUTIC STELLT SICH VOR <span class="eyebrow-badge">KI-NATIVE OPERATIONS</span></div><h1>Entdecken Sie die neue<br/>Intelligenz für<br/><span class="gradient-text">Kubernetes.</span></h1><p class="hero-lede">KI-gestützte Einblicke. Kontrollierte Aktionen. Der Mensch entscheidet. Kubernetes Operations intelligenter verstehen und sicher gestalten.</p><div class="button-group"><a class="btn btn-primary" href="/de/platform/">Plattform entdecken <span>↗</span></a><a class="btn btn-secondary" href="/de/console/">Console-Vorschau ansehen <span>↗</span></a></div><div class="hero-footnote"><span class="live-dot"></span> FÜR PLATFORM ENGINEERS, SRE-TEAMS UND OPERATIONS</div></div>
    <Network />
    <div class="hero-scroll">WEITER ENTDECKEN <span>↓</span></div>
  </section>
  <section class="trust-strip"><div class="shell trust-inner"><span>AUF OFFENEN TECHNOLOGIEN AUFGEBAUT</span><div class="trust-labels"><span>KUBERNETES</span><span>OPENKUBES</span><span>GITOPS</span><span>OFFENE OBSERVABILITY</span></div></div></section>
  <section class="section shell audience-section" id="for-teams" aria-labelledby="audience-title">
    <div class="section-heading">
      <span class="eyebrow">FÜR ALLE EBENEN DES PLATTFORMBETRIEBS</span>
      <h2 id="audience-title">Klarheit für Verantwortliche.<br/><em>Kontrolle für Engineers.</em></h2>
      <p>Von der Plattformstrategie bis zur Incident-Analyse: Kubernautic entsteht für Menschen, die Kubernetes nachvollziehbar, zuverlässig und verantwortungsvoll betreiben.</p>
    </div>
    <div class="audience-grid">
      <article class="audience-card">
        <div class="audience-meta"><span>01 / IT-VERANTWORTUNG</span><span aria-hidden="true">◇</span></div>
        <h3>Für CIOs und CTOs</h3>
        <p>Verstehen Sie operative Risiken, Governance-Grenzen und wie KI-gestützte Operations Ihre Teams wirksam unterstützen können.</p>
        <a href="/de/enterprise/" class="text-link">Enterprise-Konzept entdecken <span aria-hidden="true">↗</span></a>
      </article>
      <article class="audience-card">
        <div class="audience-meta"><span>02 / ZUVERLÄSSIGKEIT</span><span aria-hidden="true">◎</span></div>
        <h3>Für SREs und Plattformteams</h3>
        <p>Verbinden Sie einzelne Alarme zu Incident-Kontext, Belegen und nachvollziehbaren Empfehlungen – unter Kontrolle der Verantwortlichen.</p>
        <a href="/de/agentic-ai/" class="text-link">Operations-Ablauf entdecken <span aria-hidden="true">↗</span></a>
      </article>
      <article class="audience-card">
        <div class="audience-meta"><span>03 / ENTWICKLUNG</span><span aria-hidden="true">⌘</span></div>
        <h3>Für DevOps Engineers</h3>
        <p>Entdecken Sie den Kubernetes-nativn Ansatz, die geplante Read-only-Console und OK Local im OpenKubes-Ökosystem.</p>
        <a href="/de/open-source/" class="text-link">OpenKubes und OK Local entdecken <span aria-hidden="true">↗</span></a>
      </article>
    </div>
    <p class="audience-disclaimer">Eine Console-Vorschau ist in Vorbereitung. Produktive Installationen werden individuell bewertet; dieser Bereich beschreibt die geplante Benutzererfahrung.</p>
  </section>
  <section class="section shell" id="how-it-works"><div class="section-heading"><span class="eyebrow">01 / DER INTELLIGENTE KREISLAUF</span><h2>Von Signalen zu <em>Erkenntnissen.</em><br/>Von Erkenntnissen zu Kontrolle.</h2><p>Kubernetes erzeugt Signale. Kubernautic macht daraus Kontext, Empfehlungen und nachvollziehbare nächste Schritte.</p></div><div class="process-grid"><article class="process-card"><div class="card-no">01 <span>↗</span></div><div class="mini-visual visual-observe"><span></span><span></span><span></span><span></span><span></span></div><h3>Beobachten.</h3><p>Cluster-Signale, Logs, Events und Plattformstatus in einer verständlichen Ansicht zusammenführen.</p></article><article class="process-card"><div class="card-no">02 <span>↗</span></div><div class="mini-visual visual-reason"><i></i><i></i><i></i><b>✳</b></div><h3>Analysieren.</h3><p>Symptome und Kontext korrelieren, damit Verantwortliche die relevanten Zusammenhänge erkennen.</p></article><article class="process-card"><div class="card-no">03 <span>↗</span></div><div class="mini-visual visual-recommend"><span>✓</span><span>→</span><span>◇</span></div><h3>Empfehlen.</h3><p>Nachvollziehbare Handlungsempfehlungen statt undurchsichtiger Ein-Klick-Automatisierung.</p></article><article class="process-card"><div class="card-no">04 <span>↗</span></div><div class="mini-visual visual-govern"><span>◎</span><span>DURCH RICHTLINIE GESPERRT</span></div><h3>Steuern.</h3><p>Kontrolle durch klare Freigaben, definierte Grenzen und überprüfbare Entscheidungen behalten.</p></article></div></section>
  <section class="section dark-section"><div class="shell split-section"><div><span class="eyebrow">02 / DIE PRODUKTERFAHRUNG</span><h2>Eine Operations-Console<br/>für mehr <em>Klarheit.</em></h2><p>Nicht einfach noch mehr Dashboards: Ein Ort, an dem Teams Probleme erkennen, Belege prüfen und intelligente Empfehlungen verstehen.</p><a class="text-link" href="/de/console/">Console-Vorschau ansehen <span>↗</span></a></div><div class="console-mock"><div class="mock-toolbar"><span class="mock-brand">◈ kubernautic / console</span><span class="mock-status">● READ-ONLY-VORSCHAU</span></div><div class="mock-body"><div class="mock-side"><span>◉</span><span>▤</span><span>⌁</span><span>◇</span></div><div class="mock-content"><div class="mock-heading"><div><small>ÜBERSICHT / DEMOUMGEBUNG</small><h3>Operations-Intelligenz</h3></div><span class="mock-pill">DEMO</span></div><div class="mock-metrics"><div><small>WORKLOADS</small><strong>24</strong><span>↗ Gesunder Status</span></div><div><small>AKTIVE SIGNALE</small><strong>03</strong><span>● Handlungsbedarf</span></div><div><small>KI-ERKENNTNISSE</small><strong>08</strong><span>✳ Zur Prüfung bereit</span></div></div><div class="mock-insight"><div class="mock-insight-top"><span>✳ KI-GESTÜTZTE ANALYSE</span><small>BEISPIELSZENARIO</small></div><h4>Wiederkehrende Workload-Neustarts erkannt</h4><p>Wiederholte Container-Neustarts stehen zeitlich mit einer Konfigurationsänderung in der Demoumgebung in Zusammenhang.</p><div class="mock-confidence"><span>EMPFEHLUNG VERFÜGBAR</span><span>AUSFÜHRUNG DEAKTIVIERT</span></div></div><div class="mock-lower"><span>◷ Zeitachse &amp; Belege</span><span>◇ Governance-Richtlinien aktiv</span></div></div></div></div></div></section>
  <section class="section shell"><div class="section-heading narrow"><span class="eyebrow">03 / ARCHITEKTURPRINZIPIEN</span><h2>Leistungsfähige Intelligenz.<br/><em>Klare Grenzen.</em></h2><p>Offene Integration, Transparenz für Operators und ein Grundsatz: KI empfiehlt, Menschen entscheiden.</p></div><div class="feature-grid"><article><div class="feature-icon">⌘</div><h3>Kubernetes-nativ</h3><p>Ein Cloud-nativer Operations-Ansatz auf Basis des Kubernetes-Ökosystems.</p></article><article><div class="feature-icon">✳</div><h3>KI-gestützte Diagnose</h3><p>Incidents durch korrelierte Signale und beleggestützte Erklärungen verstehen.</p></article><article><div class="feature-icon">◇</div><h3>Governance von Anfang an</h3><p>Menschliche Freigaben und klare Leitplanken gehören zum Architekturkonzept.</p></article></div></section>
  <section class="section ecosystem-section"><div class="shell ecosystem-grid"><div><span class="eyebrow">04 / TEIL EINES OFFENEN ÖKOSYSTEMS</span><h2>Offene Grundlagen entdecken.<br/><em>Auf Offenheit bauen.</em></h2><p>Kubernautic ist Teil des OpenKubes-Ökosystems. Wer die Plattform auf dem eigenen Rechner entdecken möchte, findet mit OK Local den Einstieg.</p><a class="btn btn-secondary" href="https://openkubes.org" target="_blank" rel="noopener noreferrer">OK Local auf OpenKubes.org entdecken <span>↗</span></a></div><div class="ecosystem-graphic"><div class="ecosystem-center">
      <img class="ecosystem-logo" src="/openkubes-cube-v2.svg" alt="OpenKubes cube signet" width="96" height="96" loading="lazy" decoding="async" />
    </div><div class="ecosystem-wordmark" aria-label="OpenKubes"><span>OpenKubes</span><span class="ecosystem-wordmark-dot">.</span></div><div class="ecosystem-ring ring-a"></div><div class="ecosystem-ring ring-b"></div><span class="e-node en-a">LOCAL</span><span class="e-node en-b">CLOUD</span><span class="e-node en-c">EDGE</span></div></div></section>
  <CTA />
</Base>
