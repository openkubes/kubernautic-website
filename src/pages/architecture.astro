---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import ArchitectureExplorer from '../components/ArchitectureExplorer.astro';
---
<Base title="Architecture | Kubernautic">
  <section class="shell page-hero">
    <span class="eyebrow">ARCHITECTURE / GUIDING PRINCIPLES</span>
    <h1>Open foundations.<br/><span class="gradient-text">Controlled intelligence.</span></h1>
    <p>Explore an intended flow from Kubernetes signals to explainable recommendations, shaped by operator governance. This is a design concept, not a claim that every component is shipped.</p>
  </section>
  <section class="shell section single-section">
    <ArchitectureExplorer />
    <div class="content-grid">
      <article class="content-tile"><div class="tile-icon">⌁</div><h3>Authorized signals</h3><p>Scoped access to Kubernetes events, workload inventory, metrics and logs.</p></article>
      <article class="content-tile"><div class="tile-icon">✳</div><h3>Evidence-driven analysis</h3><p>Contextual hypotheses and explainable next steps that operators can review.</p></article>
      <article class="content-tile"><div class="tile-icon">◇</div><h3>Human governance</h3><p>Policies, approval boundaries and auditability as design principles.</p></article>
    </div>
  </section>
  <CTA />
</Base>
