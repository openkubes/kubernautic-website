---
import '../styles/global.css';
import BrandWordmark from '../components/BrandWordmark.astro';
const {
  title = 'Kubernautic | Agentic AI for Kubernetes Operations',
  description = 'Explore Kubernautic: AI-assisted Kubernetes incident analysis, explainable recommendations, human governance, and an interactive operations demo.',
  noindex = false
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, 'https://kubernautic.com').toString();
const siteUrl = 'https://kubernautic.com/';
const nav = [
  {href:'/platform/',label:'Platform'},
  {href:'/agentic-ai/',label:'Agentic AI'},
  {href:'/architecture/',label:'Architecture'},
  {href:'/open-source/',label:'Open Source'},
  {href:'/enterprise/',label:'Enterprise'}
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteUrl + '#website',
      name: 'Kubernautic',
      url: siteUrl,
      inLanguage: 'en',
      description: 'Agentic AI for Kubernetes operations, with explainable recommendations and human oversight.'
    },
    {
      '@type': 'WebPage',
      '@id': canonical + '#webpage',
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': siteUrl + '#website' }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070c17" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kubernautic" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://kubernautic.com/og/kubernautic-og.png" />
  <meta property="og:image:secure_url" content="https://kubernautic.com/og/kubernautic-og.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Kubernautic — Agentic AI for Kubernetes Operations. Observe. Reason. Recommend. Govern." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://kubernautic.com/og/kubernautic-og.png" />
  <meta name="twitter:image:alt" content="Kubernautic — Agentic AI for Kubernetes Operations." />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
  <title>{title}</title>
</head>
<body>
  <div class="site-glow" aria-hidden="true"></div>
  <header class="site-header">
    <div class="shell nav-wrap">
      <a class="brand" href="/" aria-label="Kubernautic Home"><img class="brand-mark" src="/kubernautic-mark.svg" alt="" width="34" height="34" decoding="async" /><BrandWordmark /></a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        {nav.map(item => <a class:list={['nav-link', {'active':path===item.href}]} href={item.href}>{item.label}</a>)}
      </nav>
      <div class="nav-actions"><a class="nav-demo" href="/console/">Console Preview <span aria-hidden="true">↗</span></a><button class="menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span><span></span></button></div>
    </div>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>{nav.map(item => <a href={item.href}>{item.label}</a>)}<a href="/console/">Console Preview</a></nav>
  </header>
  <main><slot /></main>
  <footer class="footer">
    <div class="shell footer-grid"><div><a class="brand" href="/"><img class="brand-mark" src="/kubernautic-mark.svg" alt="" width="34" height="34" decoding="async" /><BrandWordmark /></a><p>Intelligence for cloud-native operations.<br/>Built on open foundations.</p></div><div class="footer-col"><strong>Explore</strong><a href="/platform/">Platform</a><a href="/agentic-ai/">Agentic AI</a><a href="/architecture/">Architecture</a></div><div class="footer-col"><strong>Connect</strong><a href="/console/">Console Preview</a><a href="/enterprise/">Enterprise</a><a href="/contact/">Contact</a></div><div class="footer-col"><strong>Ecosystem</strong><a href="https://openkubes.org" target="_blank" rel="noopener noreferrer">OpenKubes ↗</a><a href="https://github.com/openkubes" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/open-source/">Open source</a></div></div>
    <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Kubernautic. A concept in the OpenKubes ecosystem.</span><span>Open systems. Human control.</span></div>
  </footer>
  <script>
    const toggle = document.querySelector('.menu-toggle');
    const mobile = document.querySelector('#mobile-nav');
    toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded',String(!open)); if(mobile) mobile.hidden = open; });
  </script>
</body>
</html>
